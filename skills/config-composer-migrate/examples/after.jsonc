// Native agents remain in native files. Their reviewers membership is retained.
{
  "configurationPresets": { "balanced": { "model": "fixture/review" } },
  "componentGroups": {
    "reviewers": {
      "configuration": {
        "modelRef": "preset:balanced"
      }
    }
  },
  "defaults": {
    "agents": {}
  },
  "overrides": {
    "agents": {
      "worker": {}
    }
  },
  "profiles": { "migrated": { "layers": [{ "componentGroup": "reviewers" }] } },
  "activeProfiles": ["migrated"]
}
