{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenCode Config Composer composition document",
  "description": "Canonical config-composer.jsonc definitions and explicit JSON/JSONC imports. No legacy compatibility mode. Relative paths belong to the declaring document. Structural validation only: source assembly, reference validation, and native compilation are separate phases.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "imports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/import"
      },
      "maxItems": 64,
      "uniqueItems": true,
      "description": "Explicit local JSON/JSONC files, relative to the declaring document; no automatic directory discovery. Imported documents contribute definitions, never activation."
    },
    "sourceDirectories": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/path"
      }
    },
    "components": {
      "$ref": "#/$defs/components"
    },
    "componentGroups": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/componentGroup"
      },
      "maxProperties": 1024
    },
    "configurationPresets": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/configurationPreset"
      },
      "maxProperties": 1024
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      },
      "maxProperties": 1024
    },
    "defaults": {
      "$ref": "#/$defs/defaults"
    },
    "overrides": {
      "$ref": "#/$defs/overrides"
    },
    "activeProfiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/name"
      },
      "maxItems": 64,
      "uniqueItems": true,
      "description": "Ordered named profiles. Local list replaces shared selection; absence inherits; [] selects none. Each profile replays its complete parent chain."
    }
  },
  "$defs": {
    "safeKey": {
      "not": {
        "enum": ["__proto__", "prototype", "constructor"]
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "$ref": "#/$defs/safeKey"
    },
    "componentName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\\\/]+(?:/[^\\s\\\\/]+)*$",
      "not": {
        "pattern": "(^|/)(\\.|\\.\\.|__proto__|constructor|prototype)(/|$)"
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "allOf": [
        {
          "not": {
            "pattern": "\\u0000"
          }
        },
        {
          "anyOf": [
            {
              "not": {
                "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*:"
              }
            },
            {
              "pattern": "^[a-zA-Z]:[\\\\/](?![\\\\/])"
            }
          ]
        }
      ]
    },
    "import": {
      "$ref": "#/$defs/path",
      "pattern": "\\.jsonc?$",
      "type": "string"
    },
    "model": {
      "type": "string",
      "pattern": "^[^\\s/]+/\\S+$"
    },
    "modelRef": {
      "type": "string",
      "anyOf": [
        {
          "enum": ["opencode:model", "opencode:small_model"]
        },
        {
          "pattern": "^preset:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 71,
          "not": {
            "enum": ["preset:constructor", "preset:prototype"]
          }
        }
      ]
    },
    "json": {
      "anyOf": [
        {
          "type": ["null", "boolean", "string", "number"]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/safeKey"
          },
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "topP": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "topK": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "options": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/safeKey"
          },
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      }
    },
    "permissionRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": ["allow", "ask", "deny"]
        }
      },
      "required": ["tool", "action"],
      "description": "Ordered rule. Omitted pattern means *. Last matching Composer contribution wins, including a looser action. Only no Composer match falls back to native globals, then native defaults."
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prepend": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 256
        },
        "append": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 256
        },
        "inheritDefaults": {
          "type": "boolean"
        },
        "inheritGroups": {
          "type": "boolean"
        }
      }
    },
    "configurationPreset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "$ref": "#/$defs/model"
        },
        "modelRef": {
          "$ref": "#/$defs/modelRef"
        },
        "variant": {
          "type": "string",
          "pattern": "^[\\w.-]{1,64}$"
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/permissionRule"
          },
          "maxItems": 256
        }
      },
      "not": {
        "required": ["model", "modelRef"]
      },
      "minProperties": 1,
      "description": "Reusable model and/or permission settings, independent of component membership. Partial variant/parameter contributions bind to the resolved model; catalog validation is separate."
    },
    "agentConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "$ref": "#/$defs/model"
        },
        "modelRef": {
          "$ref": "#/$defs/modelRef"
        },
        "variant": {
          "type": "string",
          "pattern": "^[\\w.-]{1,64}$"
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/permissionRule"
          },
          "maxItems": 256
        },
        "prompt": {
          "$ref": "#/$defs/prompt"
        }
      },
      "not": {
        "required": ["model", "modelRef"]
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "$ref": "#/$defs/path"
        },
        "prompt": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "mode": {
          "enum": ["primary", "subagent", "all"]
        },
        "disable": {
          "type": "boolean"
        },
        "promptRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentName"
          },
          "maxItems": 256
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentName"
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "configuration": {
          "$ref": "#/$defs/agentConfiguration"
        }
      },
      "oneOf": [
        {
          "required": ["file"]
        },
        {
          "required": ["prompt"]
        }
      ],
      "description": "Exactly one file or inline prompt. promptRefs append named prompt bodies in order. skills records intended on-demand relationships, without injecting bodies or granting exclusive access."
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "$ref": "#/$defs/path"
        }
      },
      "required": ["file"]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "$ref": "#/$defs/path"
        },
        "template": {
          "type": "string"
        },
        "agent": {
          "$ref": "#/$defs/componentName"
        },
        "description": {
          "type": "string"
        },
        "subtask": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {
          "required": ["file"]
        },
        {
          "required": ["template"]
        }
      ]
    },
    "promptComponent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "$ref": "#/$defs/path"
        },
        "text": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "required": ["file"]
        },
        {
          "required": ["text"]
        }
      ]
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agents": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/componentName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/agent"
          },
          "maxProperties": 1024
        },
        "skills": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/componentName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/skill"
          },
          "maxProperties": 1024
        },
        "commands": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/componentName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/command"
          },
          "maxProperties": 1024
        },
        "prompts": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/componentName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/promptComponent"
          },
          "maxProperties": 1024
        }
      }
    },
    "componentGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentName"
          },
          "maxItems": 256,
          "uniqueItems": true,
          "description": "Available native or custom agent names. Built-in agents need no components.agents declaration. Union with custom frontmatter groups; preserve native fields unless explicitly overridden."
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentName"
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentName"
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "prompts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentName"
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "configuration": {
          "$ref": "#/$defs/agentConfiguration"
        }
      },
      "description": "Any subset of component kinds. Configuration contributes to member agents only."
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentName"
          },
          "maxItems": 256,
          "uniqueItems": true,
          "minItems": 1
        },
        "componentGroups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          },
          "maxItems": 256,
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "minProperties": 1,
      "description": "Explicit selected agents or selected groups, resolved against available native and custom agents. Group targets expand to their agent members at this layer. Targets never select or synthesize components implicitly."
    },
    "layer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "componentGroup": {
              "$ref": "#/$defs/name"
            }
          },
          "required": ["componentGroup"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "configurationPreset": {
              "$ref": "#/$defs/name"
            },
            "target": {
              "$ref": "#/$defs/target"
            }
          },
          "required": ["configurationPreset", "target"]
        }
      ]
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "$ref": "#/$defs/model"
        },
        "small_model": {
          "$ref": "#/$defs/model"
        },
        "agents": {
          "$ref": "#/$defs/agentConfiguration"
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/permissionRule"
          },
          "maxItems": 1024
        }
      },
      "description": "Native runtime model defaults plus settings applied to all selected agents before profile contributions."
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "$ref": "#/$defs/model"
        },
        "small_model": {
          "$ref": "#/$defs/model"
        },
        "agents": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/componentName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/agentConfiguration"
          },
          "maxProperties": 1024
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/permissionRule"
          },
          "maxItems": 1024
        }
      },
      "description": "Runtime model defaults and settings keyed by selected agent. Applied after profile layers; document project overrides precede local overrides."
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extends": {
          "$ref": "#/$defs/name"
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layer"
          },
          "maxItems": 256
        },
        "overrides": {
          "$ref": "#/$defs/overrides"
        }
      },
      "description": "Single named parent. Replay the full parent chain, then child layers and overrides, for each active profile in order."
    }
  }
}
