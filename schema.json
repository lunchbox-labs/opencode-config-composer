{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/@lunchbox-labs/opencode-config-composer/schema.json",
  "title": "Config Composer",
  "description": "Shared agent group settings and one worktree profile; agents own ordered membership.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "defaultProfile": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "model": {
      "type": "string",
      "pattern": "^[^\\s/]+/\\S+$"
    },
    "small_model": {
      "type": "string",
      "pattern": "^[^\\s/]+/\\S+$"
    },
    "groups": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S",
        "not": {
          "pattern": "\\u0000"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/group"
      },
      "default": {}
    },
    "agent": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "$ref": "#/$defs/agent"
      }
    },
    "command": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "$ref": "#/$defs/command"
      }
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    },
    "models": {
      "$ref": "#/$defs/models"
    }
  },
  "$defs": {
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^[^\\s/]+/\\S+$"
        },
        "variant": {
          "type": "string"
        },
        "temperature": {
          "type": "number"
        },
        "top_p": {
          "type": "number"
        },
        "options": {
          "type": "object",
          "not": {
            "required": ["groups"]
          }
        },
        "mode": {
          "enum": ["primary", "subagent", "all"]
        },
        "permission": {
          "anyOf": [
            {
              "enum": ["allow", "ask", "deny"]
            },
            {
              "type": "object",
              "properties": {
                "todowrite": {
                  "enum": ["allow", "ask", "deny"]
                },
                "question": {
                  "enum": ["allow", "ask", "deny"]
                },
                "webfetch": {
                  "enum": ["allow", "ask", "deny"]
                },
                "websearch": {
                  "enum": ["allow", "ask", "deny"]
                },
                "doom_loop": {
                  "enum": ["allow", "ask", "deny"]
                }
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "enum": ["allow", "ask", "deny"]
                  },
                  {
                    "type": "object",
                    "additionalProperties": {
                      "enum": ["allow", "ask", "deny"]
                    }
                  }
                ]
              }
            }
          ]
        },
        "modelRef": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "not": {
            "pattern": "\\u0000"
          }
        }
      },
      "not": {
        "required": ["model", "modelRef"]
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "pattern": "^[^\\s/]+/\\S+$"
        },
        "subtask": {
          "type": "boolean"
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/$defs/agent"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "groupPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/$defs/agent"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "model": {
          "type": "string",
          "pattern": "^[^\\s/]+/\\S+$"
        },
        "small_model": {
          "type": "string",
          "pattern": "^[^\\s/]+/\\S+$"
        },
        "groups": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "not": {
              "pattern": "\\u0000"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/groupPatch"
          }
        },
        "agent": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "additionalProperties": {
            "$ref": "#/$defs/agent"
          }
        },
        "command": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "additionalProperties": {
            "$ref": "#/$defs/command"
          }
        },
        "models": {
          "$ref": "#/$defs/models"
        },
        "permission": {
          "$ref": "#/$defs/agent/properties/permission"
        }
      }
    },
    "models": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S",
        "not": {
          "pattern": "\\u0000"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/modelBinding"
      }
    },
    "modelBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model"],
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^[^\\s/]+/\\S+$"
        },
        "variant": {
          "type": "string"
        }
      }
    }
  }
}
