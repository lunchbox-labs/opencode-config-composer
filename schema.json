{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/@lunchbox-labs/opencode-config-composer/schema.json",
  "title": "Config Composer",
  "description": "One shared definition file, always-active ordered groups and one worktree profile.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "defaultProfile": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "model": {
      "type": "string",
      "pattern": "^[^\\s/]+/\\S+$"
    },
    "small_model": {
      "type": "string",
      "pattern": "^[^\\s/]+/\\S+$"
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      },
      "default": []
    },
    "agent": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "$ref": "#/$defs/agent"
      }
    },
    "command": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "$ref": "#/$defs/command"
      }
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^[^\\s/]+/\\S+$"
        },
        "variant": {
          "type": "string"
        },
        "temperature": {
          "type": "number"
        },
        "top_p": {
          "type": "number"
        },
        "options": {
          "type": "object"
        },
        "mode": {
          "enum": ["primary", "subagent", "all"]
        },
        "permission": {
          "anyOf": [
            {
              "enum": ["allow", "ask", "deny"]
            },
            {
              "type": "object",
              "properties": {
                "todowrite": { "enum": ["allow", "ask", "deny"] },
                "question": { "enum": ["allow", "ask", "deny"] },
                "webfetch": { "enum": ["allow", "ask", "deny"] },
                "websearch": { "enum": ["allow", "ask", "deny"] },
                "doom_loop": { "enum": ["allow", "ask", "deny"] }
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "enum": ["allow", "ask", "deny"]
                  },
                  {
                    "type": "object",
                    "additionalProperties": {
                      "enum": ["allow", "ask", "deny"]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "pattern": "^[^\\s/]+/\\S+$"
        },
        "subtask": {
          "type": "boolean"
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "agent": {
          "$ref": "#/$defs/agent"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "description": {
          "type": "string"
        },
        "members": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agent": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "uniqueItems": true
            },
            "command": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "uniqueItems": true
            }
          },
          "anyOf": [
            {
              "required": ["agent"],
              "properties": {
                "agent": {
                  "minItems": 1
                }
              }
            },
            {
              "required": ["command"],
              "properties": {
                "command": {
                  "minItems": 1
                }
              }
            }
          ]
        }
      },
      "required": ["name", "members"]
    },
    "groupPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "agent": {
          "$ref": "#/$defs/agent"
        },
        "command": {
          "$ref": "#/$defs/command"
        }
      },
      "required": ["name"]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "model": {
          "type": "string",
          "pattern": "^[^\\s/]+/\\S+$"
        },
        "small_model": {
          "type": "string",
          "pattern": "^[^\\s/]+/\\S+$"
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/groupPatch"
          }
        },
        "agent": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "additionalProperties": {
            "$ref": "#/$defs/agent"
          }
        },
        "command": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "additionalProperties": {
            "$ref": "#/$defs/command"
          }
        }
      }
    }
  }
}
