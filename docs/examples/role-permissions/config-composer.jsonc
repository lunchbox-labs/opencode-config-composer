{
  "groups": [
    {
      "name": "review",
      "members": {
        "agent": [
          "plan",
          "explore"
        ]
      },
      "agent": {
        "permission": {
          "bash": {
            "git *": "ask",
            "npm *": "deny"
          }
        }
      }
    },
    {
      "name": "programming",
      "members": {
        "agent": [
          "build",
          "general"
        ]
      },
      "agent": {
        "permission": {
          "bash": {
            "git *": "allow",
            "npm *": "ask"
          }
        }
      }
    }
  ],
  "profiles": {
    "cautious": {
      "groups": [
        {
          "name": "programming",
          "agent": {
            "permission": {
              "bash": "ask"
            }
          }
        }
      ]
    }
  }
}
