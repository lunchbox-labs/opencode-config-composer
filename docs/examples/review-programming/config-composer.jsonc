{
  "imports": [
    "./profiles.jsonc"
  ],
  "componentGroups": {
    "review": {
      "agents": ["code-reviewer", "test-auditor"],
      "configuration": {},
    },
    "programming": {
      "agents": ["implementer", "test-writer"],
      "configuration": {},
    },
  },
  "configurationPresets": {
    "claude-code": {
      "model": "anthropic/claude-sonnet-4-5",
      "parameters": { "maxOutputTokens": 4096 },
    },
    "openai-code": {
      "model": "openai/gpt-5",
      "parameters": { "maxOutputTokens": 4096 },
    },
    "review-checks": {
      "permissions": [
        { "tool": "bash", "pattern": "git *", "action": "ask" },
        { "tool": "bash", "pattern": "npm *", "action": "deny" },
      ],
    },
    "programming-checks": {
      "permissions": [
        { "tool": "bash", "pattern": "git *", "action": "allow" },
        { "tool": "bash", "pattern": "npm *", "action": "ask" },
      ],
    },
  },
  // Imports define profiles; this ordered selection activates one explicitly.
  "activeProfiles": ["claude-coding"],
}
