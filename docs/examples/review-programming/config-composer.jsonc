{
  "groups": {
    "review": {
      "agent": {
        "permission": {
          "bash": {
            "git *": "ask",
            "npm *": "deny",
          },
        },
      },
    },
    "programming": {
      "agent": {
        "permission": {
          "bash": {
            "git *": "allow",
            "npm *": "ask",
          },
        },
      },
    },
  },
  "profiles": {
    "review": {
      "groups": {
        "review": {
          "agent": {
            "temperature": 0,
          },
        },
      },
    },
    "programming": {
      "groups": {
        "programming": {
          "agent": {
            "temperature": 0.2,
          },
        },
      },
    },
  },
  "defaultProfile": "review",
}
