{
  "groups": [
    {
      "name": "review",
      "members": {
        "agent": [
          "plan",
          "explore"
        ]
      },
      "agent": {
        "permission": {
          "bash": {
            "git *": "ask",
            "npm *": "deny"
          }
        }
      }
    },
    {
      "name": "programming",
      "members": {
        "agent": [
          "build",
          "general"
        ]
      },
      "agent": {
        "permission": {
          "bash": {
            "git *": "allow",
            "npm *": "ask"
          }
        }
      }
    }
  ],
  "profiles": {
    "review": {
      "groups": [
        {
          "name": "review",
          "agent": {
            "temperature": 0
          }
        }
      ]
    },
    "programming": {
      "groups": [
        {
          "name": "programming",
          "agent": {
            "temperature": 0.2
          }
        }
      ]
    }
  },
  "defaultProfile": "review"
}
